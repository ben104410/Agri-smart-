# Django Settings
SECRET_KEY=your_production_secret_key_here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
# Optional: Comma-separated list of extra CSRF trusted origins
CSRF_TRUSTED_ORIGINS=https://*.onrender.com

# Database (Leave blank for SQLite in dev, or provide PostgreSQL connection string)
# DATABASE_URL=postgres://user:password@hostname:5432/dbname

# Initial Demo Data Seeding (set to 'true' to auto-seed crops and weather on deploy)
SEED_DEMO_DATA=true

# Google Gemini API Key
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Weather API Configuration
DEFAULT_FARM_LOCATION=Mombasa, Coastal Kenya
# Optional: OpenWeatherMap or Tomorrow.io API keys (leave blank to use Open-Meteo with no API key needed)
OPENWEATHERMAP_API_KEY=
TOMORROW_IO_API_KEY=

